{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "SatelliteIntelligenceFeed",
  "type": "object",
  "properties": {
    "scene_id": {
      "type": "string"
    },
    "corridor_id": {
      "type": "string"
    },
    "sensor_type": {
      "type": "string",
      "enum": [
        "OPTICAL_SENTINEL2",
        "RADAR_SAR_SENTINEL1"
      ]
    },
    "observation_date": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string"
    },
    "mgrs_or_orbit": {
      "type": "string"
    },
    "cloud_cover_pct": {
      "type": "number"
    },
    "h3_coverage_count": {
      "type": "integer"
    },
    "canonical_asset_href": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    }
  },
  "required": [
    "scene_id",
    "corridor_id",
    "sensor_type",
    "timestamp_utc",
    "canonical_asset_href"
  ]
}